{
  "name": "@qbit/prismode-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Selectable Material 3 and original Liquid Glass themes for React and MUI",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./md3-next": {
      "types": "./dist/md3-next.d.ts",
      "import": "./dist/md3-next.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "src/vendor/md3-next"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/md3-next.ts --format esm --dts --clean --external react --external react-dom --external @mui/material --external @emotion/react --external @emotion/styled"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@mui/material": "^9.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qbit-hub/prismode-ui.git",
    "directory": "packages/prismode-ui"
  },
  "homepage": "https://github.com/qbit-hub/prismode-ui#readme",
  "bugs": {
    "url": "https://github.com/qbit-hub/prismode-ui/issues"
  },
  "keywords": [
    "mui",
    "react",
    "material-design-3",
    "liquid-glass",
    "design-system",
    "theme"
  ]
}
