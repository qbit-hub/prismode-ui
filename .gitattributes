# Preserve the exact published MD3Next 0.1.3 source bytes on all platforms.
# Prevent Git from rewriting upstream source line endings during checkout.
packages/prismode-ui/src/vendor/md3-next/* -text
# The checksum manifest is generated by Prismode, not an upstream source file.
packages/prismode-ui/src/vendor/md3-next/SHA256SUMS.json text eol=lf
